# Copy this to .env (which git ignores) and fill in the passwords.
# docker compose reads .env automatically.
#
# Use letters and digits only in the passwords: storage_manager.py
# URL-quotes the username and password before handing them to pymongo,
# so punctuation would change the password it sends.

# MongoDB image.  The official 5.0+ images need an ARMv8.2-A CPU:
#   Raspberry Pi 5:         mongo:7.  (Avoid mongo:8 for now: 8.0.5 and
#                           later have been reported to crash-loop on a Pi 5.)
#   Raspberry Pi 4 / 3:     use mongo:4.4.18, the last release that runs on them.
# Either way the Pi needs a 64-bit OS; there are no 32-bit ARM mongo images.
MONGO_IMAGE=mongo:7

# Administrator account for the mongo server itself.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Account the API server uses (created on first start).
DATABASE_NAME=makespace-storage
MONGOUSER=makespace
MONGOPASSWORD=change-me-app

# The address people's browsers use to reach the web server, e.g.
# http://storage-pi.local:5000 .  Used for links in the generated pages.
STORAGE_WEB_URL=http://localhost:5000

# ---- Keycloak (logins) ----

# The address people's browsers use to reach Keycloak.  This is also
# the "issuer" written into every token, so the API server will only
# accept tokens from exactly this address.  Use https:// if Keycloak
# sits behind an HTTPS reverse proxy (see docker-compose.yaml).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=makespace

# The Keycloak admin console login (created when the database is empty).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin

# Keycloak's own PostgreSQL database.
KEYCLOAK_DB_PASSWORD=change-me-kc-db
KEYCLOAK_DB_DIR=/mnt/nvm0/keycloak-db

# Client secrets, written into the realm when it is first imported.
# Make each one a long random string, e.g. with: openssl rand -hex 32
# The web server's secret:
STORAGE_WEB_CLIENT_SECRET=change-me-web-secret
# For other services that use the API at standard user level:
STORAGE_SERVICE_CLIENT_SECRET=change-me-service-secret
# For dev-scripts/loader and other admin-level scripts:
STORAGE_MAINTENANCE_CLIENT_SECRET=change-me-maintenance-secret

# Signs the web server's session cookies (which hold login tokens).
FLASK_SECRET_KEY=change-me-flask-secret

# Host ports.
WEB_PORT=5000
API_PORT=8000
KEYCLOAK_PORT=8080
