{
  "realm": "${KEYCLOAK_REALM:makespace}",
  "displayName": "Makespace",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-${KEYCLOAK_REALM:makespace}",
        "description": "Roles every account in the realm gets",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ],
            "storage-api": [
              "user"
            ]
          }
        }
      }
    ],
    "client": {
      "storage-api": [
        {
          "name": "user",
          "description": "Standard storage user: may change the storage database",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "admin",
          "description": "Storage administrator (includes the user role)",
          "composite": true,
          "clientRole": true,
          "composites": {
            "client": {
              "storage-api": [
                "user"
              ]
            }
          }
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-${KEYCLOAK_REALM:makespace}",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "storage-api",
      "name": "Makespace storage API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {},
      "description": "Represents the API server; holds the storage roles.  No login flows.",
      "bearerOnly": false
    },
    {
      "clientId": "storage-web",
      "name": "Makespace storage web pages",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${STORAGE_WEB_URL:http://localhost:5000}/*"
      },
      "description": "The Flask web server",
      "secret": "${STORAGE_WEB_CLIENT_SECRET}",
      "rootUrl": "${STORAGE_WEB_URL:http://localhost:5000}",
      "baseUrl": "/",
      "redirectUris": [
        "${STORAGE_WEB_URL:http://localhost:5000}/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "storage-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "storage-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "membership number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "membership_number",
            "claim.name": "membership_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storage-cli",
      "name": "Makespace storage command-line tools",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "description": "Public client for people using scripts; log in with the device flow",
      "protocolMappers": [
        {
          "name": "storage-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "storage-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "membership number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "membership_number",
            "claim.name": "membership_number",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storage-service",
      "name": "Other services (standard user level)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "attributes": {},
      "description": "Example service account for other programs that use the API",
      "secret": "${STORAGE_SERVICE_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "storage-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "storage-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storage-maintenance",
      "name": "Maintenance scripts (admin level)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "attributes": {},
      "description": "Service account for dev-scripts/loader and other bulk admin jobs",
      "secret": "${STORAGE_MAINTENANCE_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "storage-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "storage-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-storage-service",
      "enabled": true,
      "serviceAccountClientId": "storage-service",
      "realmRoles": [
        "default-roles-${KEYCLOAK_REALM:makespace}"
      ],
      "clientRoles": {
        "storage-api": [
          "user"
        ]
      }
    },
    {
      "username": "service-account-storage-maintenance",
      "enabled": true,
      "serviceAccountClientId": "storage-maintenance",
      "realmRoles": [
        "default-roles-${KEYCLOAK_REALM:makespace}"
      ],
      "clientRoles": {
        "storage-api": [
          "admin"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"membership_number\", \"displayName\": \"Membership number\", \"validations\": {\"pattern\": {\"pattern\": \"^[0-9]{1,10}$\", \"error-message\": \"Membership numbers are digits only\"}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
